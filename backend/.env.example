# --- Backend environment variables ---
# Copy this file to ".env" and fill in real values. Never commit the real .env.

# MongoDB connection string (MongoDB Atlas)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/lifeos

# Secret used to sign JWTs. Use a long, random string.
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on (optional, defaults to 5000)
PORT=5000

# Allowed frontend origin(s) for CORS. Comma-separate multiple values.
# Example: https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
